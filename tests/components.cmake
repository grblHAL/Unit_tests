include(CTest)
option(ENABLE_SANITIZERS "Enable address and undefined behavior checks" OFF)
option(ENABLE_COVERAGE "Instrument selected component" OFF)
get_filename_component(HARNESS_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT EXISTS "${HARNESS_ROOT}/core/hal.h")
  message(FATAL_ERROR "Fetch the suite's source lock with scripts/prepare_sources.py first")
endif()
file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/include/grbl")
# Plugins use the firmware driver's grbl/ include layout.
file(GLOB headers "${HARNESS_ROOT}/core/*.h")
foreach(header IN LISTS headers)
  get_filename_component(name "${header}" NAME)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/include/grbl/${name}" "#include \"${header}\"\n")
endforeach()
function(component_case name)
  add_executable(${name} ${ARGN})
  target_compile_features(${name} PRIVATE c_std_11)
  target_include_directories(${name} PRIVATE "${HARNESS_ROOT}/core" "${HARNESS_ROOT}/tests" "${CMAKE_CURRENT_BINARY_DIR}/include" "${CMAKE_CURRENT_SOURCE_DIR}")
  if(NOT MSVC)
    target_compile_options(${name} PRIVATE -Wall -Wextra -Werror)
    target_link_libraries(${name} PRIVATE m)
    if(ENABLE_SANITIZERS)
      target_compile_options(${name} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
      target_link_options(${name} PRIVATE -fsanitize=address,undefined)
    endif()
    if(ENABLE_COVERAGE)
      target_compile_options(${name} PRIVATE --coverage -O0 -g)
      target_link_options(${name} PRIVATE --coverage)
    endif()
  endif()
  add_test(NAME ${name} COMMAND ${name})
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${name}")
  set_tests_properties(${name} PROPERTIES WORKING_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/${name}")
endfunction()
